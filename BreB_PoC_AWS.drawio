        <mxCell id="e6" value="reintentos agotados (maxReceiveCount=5)" style="endArrow=classic;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="sqsIcon" target="dlqIcon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="métricas/logs" style="endArrow=none;html=1;dashed=1;strokeColor=#759C3E;fontColor=#759C3E;" edge="1" parent="1" source="lamIcon" target="cwIcon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="trazas" style="endArrow=none;html=1;dashed=1;strokeColor=#759C3E;fontColor=#759C3E;" edge="1" parent="1" source="lamIcon" target="xrayIcon"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== Criterios y nota ===== -->
        <mxCell id="crit" value="Criterios de éxito:  ≥ 10 TPS sostenido   ·   ≥ 99% procesado en ≤ 60 min   ·   p95 ≤ 2 s   ·   error rate &lt; 1%   ·   0 mensajes perdidos   ·   0 pagos duplicados" style="text;html=1;align=center;fontStyle=2;fontColor=#2d6a2d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="640" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="nota" value="Nota de diseño: la organización de la cuenta bloquea las Lambda Function URLs (403). Por eso el consumer invoca el stub por la API de Lambda (lambda:InvokeFunction), no por HTTP." style="text;html=1;align=center;fontStyle=2;fontColor=#8a4b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="668" width="1200" height="30" as="geometry"/></mxCell>
