        <!-- ===== Pie ===== -->
        <mxCell id="crit" value="Criterios de éxito:  ≥ 10 TPS sostenido   ·   ≥ 99% procesado en ≤ 60 min   ·   p95 ≤ 2 s   ·   error rate &lt; 1%   ·   0 mensajes perdidos   ·   0 pagos duplicados" style="text;html=1;align=center;fontStyle=2;fontColor=#2d6a2d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="840" width="1200" height="24" as="geometry"/></mxCell>
        <mxCell id="nota" value="Nota de diseño: la organización de la cuenta bloquea las Lambda Function URLs (403). Por eso el consumer invoca el stub por la API de Lambda (lambda:InvokeFunction), no por HTTP." style="text;html=1;align=center;fontStyle=2;fontColor=#8a4b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="868" width="1200" height="20" as="geometry"/></mxCell>
