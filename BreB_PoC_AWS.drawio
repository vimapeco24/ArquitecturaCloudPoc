        <mxCell id="dlqIcon" value="Amazon SQS — DLQ&#10;breb-poc-dlq&#10;no procesables tras maxReceiveCount=5" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_queue_service;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="78" height="78" as="geometry"/></mxCell>

