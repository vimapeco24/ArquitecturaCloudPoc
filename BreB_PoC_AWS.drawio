      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Prueba de Concepto (PoC) sobre AWS — Pagos Programados Bre-B&#10;Valida ASR-1 (desempeño en ventana 6:00 a.m.) y ASR-2 (0 pérdidas / 0 duplicados)" style="text;html=1;align=center;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="200" y="12" width="1200" height="40" as="geometry"/></mxCell>

        <mxCell id="fecha" value="Actualizado: 2026-10-28 · Cuenta aftc_test (803647807230) · Región us-east-2 (Ohio) · Estado: DESPLEGADO y VERIFICADO end-to-end" style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="1200" height="20" as="geometry"/></mxCell>

        <!-- ===== Nube AWS (grupo) ===== -->
        <mxCell id="awsCloud" value="AWS Cloud · us-east-2 (Ohio)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1080" height="520" as="geometry"/></mxCell>

        <!-- ===== Generador de carga (fuera de la nube) ===== -->
        <mxCell id="loadIcon" value="k6&#10;(generador de carga)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.distributed_load_testing;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="78" height="78" as="geometry"/></mxCell>
        <mxCell id="loadTxt" value="Normal 2.000 · Estrés 6.000 · Fallo +duplicados&#10;SendMessage a SQS (SigV4)" style="text;html=1;align=center;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="390" width="200" height="34" as="geometry"/></mxCell>

