        <mxCell id="cwIcon" value="Amazon CloudWatch&#10;dashboard + 2 alarmas" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="78" height="78" as="geometry"/></mxCell>

        <!-- ===== X-Ray ===== -->
        <mxCell id="xrayIcon" value="AWS X-Ray&#10;trazas E2E" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="1"><mxGeometry x="880" y="490" width="78" height="78" as="geometry"/></mxCell>

        <!-- ===== Flechas ===== -->
