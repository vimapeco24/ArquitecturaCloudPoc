        <mxCell id="schIcon" value="EventBridge Scheduler&#10;(opcional, deshabilitado)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_scheduler;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="78" height="78" as="geometry"/></mxCell>

        <!-- ===== SQS cola principal ===== -->
        <mxCell id="sqsIcon" value="Amazon SQS&#10;breb-poc-queue&#10;Queue-Based Load Leveling" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_queue_service;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="78" height="78" as="geometry"/></mxCell>

        <!-- ===== Lambda consumer ===== -->
        <mxCell id="lamIcon" value="AWS Lambda — consumer&#10;breb-poc-consumer&#10;dosificado maximum_concurrency=2&#10;idempotencia + backoff + ReportBatchItemFailures" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="78" height="78" as="geometry"/></mxCell>

        <!-- ===== Lambda stub backend ===== -->
        <mxCell id="stubIcon" value="AWS Lambda — stub backend&#10;breb-poc-stub-backend&#10;invocado por API de Lambda (invoke)&#10;latencia simulada + 5% error transitorio" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1050" y="150" width="78" height="78" as="geometry"/></mxCell>

