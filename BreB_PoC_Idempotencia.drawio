<mxfile host="app.diagrams.net" agent="Kiro" version="24.0.0">
  <diagram name="PoC Idempotencia" id="poc-idem">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PoC Bre-B · ASR-2 — Procesamiento exactamente-una-vez (idempotencia y DLQ)&#10;Amazon DynamoDB con PutItem condicional: ni pérdidas ni pagos duplicados" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1200" height="44" as="geometry"/></mxCell>

        <!-- ============ COLUMNA CENTRAL: entrada y decisión de idempotencia ============ -->
        <mxCell id="start" value="Mensaje de SQS&#10;payment_id = P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4F1;strokeColor=#E7157B;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="220" height="60" as="geometry"/></mxCell>

        <mxCell id="dec" value="DynamoDB · PutItem condicional&#10;attribute_not_exists(payment_key)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAE6FB;strokeColor=#2E27AD;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="220" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="eStartDec" style="endArrow=classic;html=1;strokeColor=#232F3E;" edge="1" parent="1" source="start" target="dec"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ RAMA IZQUIERDA: CLAVE NUEVA (procesa) ============ -->
        <mxCell id="hdrNew" value="RAMA A · Clave NUEVA → se procesa el pago" style="text;html=1;align=center;fontStyle=1;fontColor=#1b4d1b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="300" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="newBox" value="Reserva OK · status = PROCESSING&#10;(la clave no existía)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#1b4d1b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="330" width="320" height="56" as="geometry"/></mxCell>
        <mxCell id="eNew" value="éxito" style="endArrow=classic;html=1;fontColor=#2d6a2d;strokeColor=#2d6a2d;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="dec" target="newBox"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="285"/></Array></mxGeometry></mxCell>

        <mxCell id="invokeIcon" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="270" y="420" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="invokeTxt" value="invoke stub backend (ejecuta la transferencia)" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="180" y="482" width="240" height="24" as="geometry"/></mxCell>
        <mxCell id="eInv" style="endArrow=classic;html=1;strokeColor=#ED7100;" edge="1" parent="1" source="newBox" target="invokeIcon"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="decR" value="¿Backend respondió 200?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#ED7100;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="540" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="eInvR" style="endArrow=classic;html=1;strokeColor=#ED7100;" edge="1" parent="1" source="invokeIcon" target="decR"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="done" value="UpdateItem status = DONE&#10;→ pago ejecutado 1 vez&#10;→ log: &quot;processed&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#1b4d1b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="710" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="eDone" value="sí (EXECUTED)" style="endArrow=classic;html=1;fontColor=#2d6a2d;strokeColor=#2d6a2d;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="decR" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="retry" value="Libera reserva (delete si PROCESSING)&#10;Reintentos con backoff (hasta 3)&#10;Si persisten → excepción" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#b85450;fontColor=#8a2f23;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="705" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="eRetry" value="no (503 / timeout)" style="endArrow=classic;html=1;fontColor=#b85450;strokeColor=#b85450;exitX=0.75;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="decR" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- SQS reintrega + DLQ -->
        <mxCell id="sqsBack" value="SQS reintrega el mensaje&#10;(ReportBatchItemFailures)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4F1;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="860" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="eSqsBack" style="endArrow=classic;html=1;strokeColor=#E7157B;" edge="1" parent="1" source="retry" target="sqsBack"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="dlqDec" value="¿superó&#10;maxReceiveCount = 5?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCE4F1;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="850" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="eDlqDec" value="" style="endArrow=classic;html=1;strokeColor=#E7157B;" edge="1" parent="1" source="sqsBack" target="dlqDec"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eReproc" value="no → reintenta" style="endArrow=classic;html=1;dashed=1;strokeColor=#C9A000;fontColor=#8a6d00;fontSize=10;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="dlqDec" target="dec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="300"/><mxPoint x="660" y="285"/></Array></mxGeometry></mxCell>

        <mxCell id="dlqIcon" value="" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.queue;" vertex="1" parent="1"><mxGeometry x="140" y="1000" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="dlqTxt" value="&lt;b&gt;DLQ&lt;/b&gt; breb-poc-dlq&#10;no procesable (0 pérdidas, se inspecciona)" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="90" y="1062" width="170" height="40" as="geometry"/></mxCell>
        <mxCell id="eDlq" value="sí → a la DLQ" style="endArrow=classic;html=1;fontColor=#E7157B;strokeColor=#E7157B;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dlqDec" target="dlqIcon"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ RAMA DERECHA: CLAVE DUPLICADA (omite) ============ -->
        <mxCell id="hdrDup" value="RAMA B · Clave DUPLICADA → se omite (no se ejecuta)" style="text;html=1;align=center;fontStyle=1;fontColor=#1b4d1b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="400" height="20" as="geometry"/></mxCell>
        <mxCell id="dupBox" value="ConditionalCheckFailedException&#10;(la clave P ya existía)&#10;→ log: &quot;duplicate_skipped&quot;&#10;→ NO se invoca el backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#1b4d1b;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="eDup" value="falla condición (ya existe P)" style="endArrow=classic;html=1;fontColor=#2d6a2d;strokeColor=#2d6a2d;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="dec" target="dupBox"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1360" y="285"/></Array></mxGeometry></mxCell>

        <mxCell id="dupResult" value="El pago con payment_id = P se ejecuta UNA sola vez, sin importar cuántas veces se reentregue el mensaje&#10;(reintentos de SQS, doble entrega at-least-once o duplicado del productor).&#10;Garantía exactamente-una-vez → ASR-2 cumplido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#1b4d1b;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1140" y="460" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="eDupRes" style="endArrow=classic;html=1;strokeColor=#2d6a2d;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dupBox" target="dupResult"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ============ TABLA DynamoDB (abajo, ancho completo) ============ -->
        <mxCell id="ddbIcon" value="" style="sketch=0;outlineConnect=0;fillColor=#2E27AD;strokeColor=none;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="700" y="980" width="60" height="60" as="geometry"/></mxCell>
        <mxCell id="ddbItem" value="Tabla breb-poc-idempotency (ejemplo de ítem):  payment_key = demo-inv-001 · status = DONE · created_at · done_at · expires_at (TTL)" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=11;fontColor=#232F3E;fillColor=#F3F2FC;strokeColor=#2E27AD;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="985" width="620" height="50" as="geometry"/></mxCell>

        <mxCell id="foot" value="Clave: el PutItem condicional es atómico — dos entregas concurrentes del mismo payment_id no pueden tener éxito ambas. Ni se pierde (DLQ) ni se duplica (idempotencia)." style="text;html=1;align=center;fontStyle=2;fontColor=#2d6a2d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1110" width="1200" height="24" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
