<mxfile host="app.diagrams.net" agent="Kiro" version="24.0.0">
  <diagram name="PoC Runbook" id="poc-run">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PoC Bre-B · Paso a paso para ejecutar y demostrar el experimento en AWS&#10;Consola web + CloudShell · Cuenta aftc_test (803647807230) · Región us-east-2 (Ohio)" style="text;html=1;align=center;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="250" y="16" width="1200" height="44" as="geometry"/></mxCell>

        <!-- Fase 0 -->
        <mxCell id="f0" value="&lt;b&gt;Fase 0 · Entrar a AWS&lt;/b&gt;&#10;console.aws.amazon.com (us-east-2)&#10;Abrir CloudShell (icono &gt;_)&#10;Confirmar región Ohio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1F3864;fontColor=#1F3864;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="220" height="110" as="geometry"/></mxCell>

        <!-- Fase 1 -->
        <mxCell id="f1" value="&lt;b&gt;Fase 1 · Desplegar / verificar&lt;/b&gt;&#10;git clone / git pull&#10;terraform init &amp; apply&#10;(idempotente: 'No changes')&#10;export QUEUE_URL, DLQ_URL, TABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#ED7100;fontColor=#8a4b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="230" height="110" as="geometry"/></mxCell>

        <!-- Fase 2 -->
        <mxCell id="f2" value="&lt;b&gt;Fase 2 · Limpiar entorno&lt;/b&gt;&#10;purge-queue (cola + DLQ)&#10;esperar 60 s&#10;confirmar ambas en 0&#10;(métricas parten de cero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4F1;strokeColor=#E7157B;fontColor=#8a1f5c;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="220" height="110" as="geometry"/></mxCell>

        <!-- Fase 3 -->
        <mxCell id="f3" value="&lt;b&gt;Fase 3 · Ejecutar carga&lt;/b&gt;&#10;load/load_cli.sh&#10;A) 2000 normal  (ASR-1)&#10;B) 6000 stress  (pico 6 a.m.)&#10;C) 2000 fault 25  (ASR-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9FB;strokeColor=#7D3C98;fontColor=#5b2c6f;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="910" y="110" width="230" height="110" as="geometry"/></mxCell>

        <!-- Fase 4 -->
        <mxCell id="f4" value="&lt;b&gt;Fase 4 · Observar en vivo&lt;/b&gt;&#10;2a pestaña CloudShell&#10;watch profundidad de cola&#10;logs tail del consumer&#10;(processed / duplicate_skipped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#1b4d1b;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="230" height="110" as="geometry"/></mxCell>

        <!-- Fase 5 -->
        <mxCell id="f5" value="&lt;b&gt;Fase 5 · Verificar criterios&lt;/b&gt;&#10;scripts/verify.sh&#10;cola a 0 · DLQ a 0 (normal/estrés)&#10;#processed == enviados únicos&#10;#payment_key en DynamoDB (0 duplicados)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#1b4d1b;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1190" y="290" width="230" height="120" as="geometry"/></mxCell>

        <!-- Fase 6 -->
        <mxCell id="f6" value="&lt;b&gt;Fase 6 · Demostrar por consola (a los profesores)&lt;/b&gt;&#10;1) Dashboard CloudWatch (cola sube/baja = Queue-Based Load Leveling)&#10;2) SQS breb-poc-queue + DLQ (maxReceiveCount=5)&#10;3) Lambda consumer -&gt; logs (processed / duplicate_skipped)&#10;4) DynamoDB breb-poc-idempotency (cada payment_key una vez, status=DONE)&#10;5) X-Ray Service map (consumer -&gt; stub -&gt; DynamoDB)&#10;6) CloudWatch Alarms (consumer-errors, dlq-not-empty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C9A000;fontColor=#6b5200;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="360" y="300" width="760" height="150" as="geometry"/></mxCell>

        <!-- Fase 7 opcional -->
        <mxCell id="f7" value="&lt;b&gt;Fase 7 · (Opcional) Demo manual de 1 pago&lt;/b&gt;&#10;SQS Send message (payment_id nuevo) -&gt; logs 'processed' -&gt;&#10;DynamoDB item DONE; reenviar el mismo -&gt; 'duplicate_skipped' (idempotencia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#1F3864;fontColor=#1F3864;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="760" height="80" as="geometry"/></mxCell>

        <!-- Fase 8 opcional -->
        <mxCell id="f8" value="&lt;b&gt;Fase 8 · (Opcional) Limpieza&lt;/b&gt;&#10;terraform destroy -auto-approve&#10;(apaga la PoC tras la entrega)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#b85450;fontColor=#8a2f23;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="910" y="490" width="510" height="80" as="geometry"/></mxCell>

        <!-- Flechas fila 1 -->
        <mxCell id="a01" style="endArrow=classic;html=1;strokeColor=#232F3E;" edge="1" parent="1" source="f0" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a12" style="endArrow=classic;html=1;strokeColor=#232F3E;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a23" style="endArrow=classic;html=1;strokeColor=#232F3E;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a34" style="endArrow=classic;html=1;strokeColor=#232F3E;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a45" style="endArrow=classic;html=1;strokeColor=#232F3E;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a56" style="endArrow=classic;html=1;strokeColor=#232F3E;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a67" style="endArrow=classic;html=1;dashed=1;strokeColor=#888;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a68" style="endArrow=classic;html=1;dashed=1;strokeColor=#888;exitX=0.9;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="f6" target="f8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="foot" value="Runbook completo con los comandos copy-paste en RUNBOOK_EXPERIMENTO.md · Guion de consola en GUIA_CONSOLA_AWS.md" style="text;html=1;align=center;fontStyle=2;fontColor=#555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="600" width="1200" height="20" as="geometry"/></mxCell>
