# Copia a terraform.tfvars y ajusta según el escenario.

aws_region  = "us-east-2"   # Ohio (región del despliegue verificado)
name_prefix = "breb-poc"

# --- Queue-Based Load Leveling ---
# N: límite de solicitudes paralelas al backend. En cuentas sandbox cuyo límite
# total de concurrencia es 10 (y no permiten reservar a nivel de función), deja
# reserved_concurrency = 0: el dosificado se mantiene vía el maximum_concurrency
# del event source mapping (mínimo 2). En producción, dimensiónalo a la capacidad
# real del core (p. ej. 20) para sostener >= 10 TPS dentro de la ventana de 60 min.
reserved_concurrency       = 2    # PoC sandbox. Producción: 20.
sqs_batch_size             = 10
max_receive_count          = 5
visibility_timeout_seconds = 60

# --- Consumidor ---
consumer_timeout_seconds = 30
consumer_memory_mb       = 256
max_retries              = 3

# --- Stub backend ---
# Escenario "normal"/"estrés": stub_error_rate = 0.0
# Escenario "fallo transitorio": stub_error_rate = 0.05  (5%)
stub_error_rate     = 0.05
stub_latency_min_ms = 50
stub_latency_max_ms = 300

# --- Scheduler (opcional) ---
enable_scheduler    = false
schedule_expression = "cron(0 6 * * ? *)"
