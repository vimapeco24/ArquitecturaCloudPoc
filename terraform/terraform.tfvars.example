# Copia a terraform.tfvars y ajusta según el escenario.

aws_region  = "us-east-2"   # Ohio (región del despliegue verificado)
name_prefix = "breb-poc"

# --- Queue-Based Load Leveling ---
# reserved_concurrency: concurrencia RESERVADA a nivel de función.
#   En sandbox (límite total de concurrencia = 10) déjalo en 0: AWS no permite
#   reservar todo el límite. El dosificado efectivo lo da sqs_max_concurrency.
#   En producción, p. ej. 20 (dimensionado a la capacidad del backend).
# sqs_max_concurrency: maximum_concurrency del event source mapping SQS->Lambda
#   = nº máx. de invocaciones concurrentes (control real de Queue-Based Load Leveling).
#   En sandbox 10 sostiene throughput alto; mínimo permitido 2.
reserved_concurrency       = 0
sqs_max_concurrency        = 10
sqs_batch_size             = 10
max_receive_count          = 5
visibility_timeout_seconds = 60

# --- Consumidor ---
consumer_timeout_seconds = 30
consumer_memory_mb       = 256
max_retries              = 3

# --- Stub backend ---
# Escenario "normal"/"estrés": stub_error_rate = 0.0
# Escenario "fallo transitorio": stub_error_rate = 0.05  (5%)
stub_error_rate     = 0.05
stub_latency_min_ms = 50
stub_latency_max_ms = 300

# --- Arquitectura Step Functions + Map distribuido ---
# sfn_total_payments: pagos que el controller genera por corrida (volumen diario del ASR).
# sfn_max_concurrency: workers EN PARALELO del Map = control de ritmo (reemplaza la cola).
#   ASR: máx 10 TPS procesando 20.000 en 1 h. Con latencia del core ~0.175 s,
#   TPS ≈ concurrencia / latencia → concurrencia ≈ 2 da ~10 TPS. Default 2
#   (cumple ASR y cabe en el límite de concurrencia 10 de la cuenta sandbox).
#   Subir solo si se amplía el límite del core y se quiere acortar la ventana.
# sfn_item_batch_count: pagos por invocación del worker (1 = un pago por worker).
sfn_total_payments   = 20000
sfn_max_concurrency  = 2
sfn_item_batch_count = 1
worker_timeout_seconds = 30
worker_memory_mb       = 256

# --- Scheduler (opcional) ---
# Si enable_scheduler = true, un EventBridge Scheduler inicia la máquina de estados
# (arquitectura nueva) a la hora de schedule_expression (simula el lote de las 6:00 a.m.).
enable_scheduler    = false
schedule_expression = "cron(0 6 * * ? *)"
