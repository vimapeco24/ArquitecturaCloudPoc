        <mxCell id="dupBox" value="Rama de duplicado (ASR-2): si el payment_id ya existe, el consumer registra &quot;duplicate_skipped&quot; y NO invoca el backend → el pago no se ejecuta dos veces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2d6a2d;fontColor=#2d6a2d;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="700" height="50" as="geometry"/></mxCell>

