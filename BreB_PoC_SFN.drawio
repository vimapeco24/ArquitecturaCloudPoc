<mxfile host="app.diagrams.net" agent="Kiro" version="24.0.0">
  <diagram name="PoC AWS - Step Functions" id="poc-sfn">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PoC sobre AWS — Pagos Programados Bre-B · Arquitectura con Step Functions + Map DISTRIBUIDO&#10;Valida ASR-1 (20.000 pagos en ventana de 1 h, máx 10 TPS) y ASR-2 (0 pérdidas / 0 duplicados)" style="text;html=1;align=center;fontSize=15;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="240" y="14" width="1280" height="44" as="geometry"/></mxCell>
        <mxCell id="sub" value="Reemplaza la cola SQS + Lambda consumer: el Load Leveling lo da ahora la CONCURRENCIA del Map (MaxConcurrency). Reutiliza el stub del core y la tabla de idempotencia. Evidencia en AWS: historia de Step Functions + resultados del Map en S3 + DynamoDB + CloudWatch + X-Ray." style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="1280" height="30" as="geometry"/></mxCell>

        <!-- Nube AWS -->
        <mxCell id="awsCloud" value="AWS Cloud · us-east-2 (Ohio)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;container=0;pointerEvents=0;collapsible=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="1560" height="800" as="geometry"/></mxCell>

        <!-- Scheduler -->
        <mxCell id="schIcon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="171" y="200" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="schTxt" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&#10;(opcional · dispara el lote 6:00 a.m.)" style="text;html=1;align=center;fontSize=10;fontColor=#777;" vertex="1" parent="1"><mxGeometry x="116" y="272" width="180" height="34" as="geometry"/></mxCell>

        <!-- Caja Step Functions -->
        <mxCell id="sfnBox" value="AWS Step Functions — breb-poc-pagos (STANDARD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E7157B;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#E7157B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="760" height="470" as="geometry"/></mxCell>

        <!-- 1. Controller -->
        <mxCell id="ctrlIcon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="371" y="210" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="ctrlTxt" value="&lt;b&gt;1 · Controller (Lambda)&lt;/b&gt;&#10;consulta/genera los 20.000 pagos del día&#10;→ dataset JSONL en S3" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="316" y="282" width="190" height="46" as="geometry"/></mxCell>

        <!-- S3 dataset -->
        <mxCell id="s3Icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="371" y="400" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="s3Txt" value="&lt;b&gt;Amazon S3 — bucket de datos&lt;/b&gt;&#10;datasets/&lt;run_id&gt;.jsonl (entrada, ItemReader)&#10;resultados/&lt;run_id&gt;/ (salida, ResultWriter = evidencia)" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="300" y="472" width="230" height="46" as="geometry"/></mxCell>

        <!-- 2. Map distribuido -->
        <mxCell id="mapBox" value="2 · Map DISTRIBUIDO&#10;itera el dataset EN PARALELO · MaxConcurrency = N (dosifica ≤ 10 TPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F3;strokeColor=#E7157B;verticalAlign=top;fontSize=10;fontStyle=1;fontColor=#8a1f5a;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="490" height="250" as="geometry"/></mxCell>

        <!-- Worker 1..N -->
        <mxCell id="wIcon3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="620" y="300" width="64" height="64" as="geometry"/></mxCell>
        <mxCell id="wIcon2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="604" y="284" width="64" height="64" as="geometry"/></mxCell>
        <mxCell id="wIcon1" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="588" y="268" width="64" height="64" as="geometry"/></mxCell>
        <mxCell id="wTxt" value="&lt;b&gt;Worker (Lambda) × N en paralelo&lt;/b&gt;&#10;idempotencia (DynamoDB) → dispara evento al core&#10;→ espera respuesta → verifica estado → actualiza pago&#10;reintentos + backoff; si falla definitivo → FAILED + notifica" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="690" y="276" width="350" height="56" as="geometry"/></mxCell>
        <mxCell id="retryTxt" value="Retry de la máquina de estados (TaskFailed/Throttle) · ToleratedFailurePercentage" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#8a1f5a;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="420" height="30" as="geometry"/></mxCell>

        <!-- core stub -->
        <mxCell id="coreIcon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1200" y="230" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="coreTxt" value="&lt;b&gt;Lambda — stub del core bancario&lt;/b&gt;&#10;breb-poc-stub-backend&#10;latencia simulada + 5% error transitorio&#10;(invocado por API de Lambda)" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="1150" y="302" width="200" height="52" as="geometry"/></mxCell>

        <!-- DynamoDB -->
        <mxCell id="ddbIcon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1200" y="430" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="ddbTxt" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&#10;breb-poc-idempotency · PutItem condicional&#10;PROCESSING/DONE/FAILED + TTL → 0 duplicados" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="1140" y="502" width="240" height="46" as="geometry"/></mxCell>

        <!-- Observabilidad -->
        <mxCell id="cwIcon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1"><mxGeometry x="500" y="660" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="cwTxt" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&#10;dashboard SFN + alarma ExecutionsFailed&#10;+ logs de la máquina de estados" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="440" y="732" width="200" height="46" as="geometry"/></mxCell>

        <mxCell id="xrayIcon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="70" height="70" as="geometry"/></mxCell>
        <mxCell id="xrayTxt" value="&lt;b&gt;AWS X-Ray&lt;/b&gt;&#10;trazas E2E" style="text;html=1;align=center;fontSize=10;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="640" y="732" width="190" height="30" as="geometry"/></mxCell>

        <!-- Flechas -->
        <mxCell id="e0" value="inicia ejecución (off)" style="endArrow=classic;html=1;dashed=1;fontColor=#999;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="schIcon" target="ctrlIcon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="escribe dataset" style="endArrow=classic;html=1;fontColor=#232F3E;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ctrlIcon" target="s3Icon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="ItemReader (JSONL)" style="endArrow=classic;html=1;fontColor=#232F3E;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3Icon" target="mapBox"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="dispara evento + espera respuesta" style="endArrow=classic;html=1;fontColor=#232F3E;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="mapBox" target="coreIcon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="idempotencia / estado" style="endArrow=classic;html=1;fontColor=#232F3E;fontSize=10;exitX=1;exitY=0.8;entryX=0;entryY=0.3;" edge="1" parent="1" source="mapBox" target="ddbIcon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="ResultWriter (evidencia)" style="endArrow=classic;html=1;dashed=1;strokeColor=#7AA116;fontColor=#5a7a0f;fontSize=10;exitX=0.3;exitY=1;entryX=0.5;entryY=0.3;" edge="1" parent="1" source="mapBox" target="s3Icon"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Pie -->
        <mxCell id="crit" value="Criterios de éxito:  20.000 pagos procesados en ≤ 60 min   ·   ≤ 10 TPS (dosificado por MaxConcurrency)   ·   p95 ≤ 2 s   ·   error rate &lt; 1%   ·   0 pagos perdidos   ·   0 pagos duplicados" style="text;html=1;align=center;fontStyle=2;fontColor=#2d6a2d;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="928" width="1280" height="24" as="geometry"/></mxCell>
